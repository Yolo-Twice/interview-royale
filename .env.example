# Copy to `.env` and fill in values from Firebase Console → Project settings → Your apps (Web).
# Vite only exposes variables prefixed with VITE_ to the client bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed if you enable Google Analytics in Firebase
VITE_FIREBASE_MEASUREMENT_ID=
